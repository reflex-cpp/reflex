@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Boost COMPONENTS headers CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/reflexTargets.cmake")

if (WIN32)
    # The auto-generated code doesn't add ${_IMPORT_PREFIX} to the natvis path in INTERFACE_LINK_OPTIONS.
    get_target_property(REFLEX_NATVIS_PATH reflex::reflex INTERFACE_LINK_DEPENDS)
    set_target_properties(reflex::reflex PROPERTIES INTERFACE_LINK_OPTIONS "-natvis:${REFLEX_NATVIS_PATH}")
    unset(REFLEX_NATVIS_PATH)
endif ()

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

check_required_components(reflex)